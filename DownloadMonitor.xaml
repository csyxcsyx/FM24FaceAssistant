<Window x:Class="FM24FaceAssistant.DownloadMonitor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="assistant.ico" Title="NG_Regens 下载监控" Width="1080" Height="610" MinWidth="720" MinHeight="520" Background="#111827" Foreground="#E2E8F0" WindowStartupLocation="CenterScreen">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><TextBlock DockPanel.Dock="Right" Text="内置下载" Foreground="#45D6A0" FontFamily="Consolas" VerticalAlignment="Center"/><StackPanel><TextBlock Text="NG_Regens 下载监控" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="程序内置下载 · 退出时保存进度" Foreground="#A4B3C6"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StageText" Text="读取状态…" FontSize="16"/><TextBlock x:Name="Percentage" Grid.Column="1" FontSize="22" FontFamily="Consolas" Foreground="#45D6A0"/></Grid><ProgressBar x:Name="Overall" Height="14" Background="#263449" Foreground="#45D6A0" BorderThickness="0" Minimum="0" Maximum="100" Margin="3,8"/><TextBlock x:Name="SavedBytes" Foreground="#CAD5E3" FontFamily="Consolas"/>
  <TextBlock x:Name="ConnectionText" Margin="3,12,3,3" Foreground="#A4B3C6"/><ProgressBar x:Name="Transfer" Height="6" Background="#263449" Foreground="#60A5FA" BorderThickness="0" Minimum="0" Maximum="100" Margin="3,5"/></StackPanel>
  <Grid Grid.Row="2" Margin="0,14,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RateLabel" Text="最近传输速度" Foreground="#93A4BB"/><TextBlock x:Name="Rate" FontSize="20" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="RemainingLabel" Text="本次连接预计剩余" Foreground="#93A4BB"/><TextBlock x:Name="Remaining" FontSize="20" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="连接 / 更新时间" Foreground="#93A4BB"/><TextBlock x:Name="Attempt" FontSize="17" FontFamily="Consolas"/></StackPanel></Grid>
  <TextBox Grid.Row="3" x:Name="Log" Height="Auto" MinHeight="0" VerticalContentAlignment="Top" IsReadOnly="True" Background="#0B1220" Foreground="#A8DCC8" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="下载事件日志"/>
  <DockPanel Grid.Row="4" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Recovery" Content="继续处理" IsEnabled="False" Foreground="#F4F0F9" Click="ResumeWorker"/><Button Content="取消下载" Foreground="#F4F0F9" Click="CancelDownload"/><Button Content="打开下载目录" Foreground="#F4F0F9" Click="OpenFolder"/><Button Content="选择下载位置" Foreground="#F4F0F9" Click="ChooseLocation"/><Button Content="查看日志" Foreground="#F4F0F9" Click="OpenLogs"/><Button Content="关闭监控" Foreground="#F4F0F9" Click="CloseMonitor"/></StackPanel><TextBlock x:Name="Footer" Foreground="#93A4BB" VerticalAlignment="Center" TextWrapping="Wrap" Text="仅加载男性球员、男性职员和女性职员素材。"/></DockPanel>
 </Grid>
</Window>
