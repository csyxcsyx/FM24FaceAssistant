<UserControl x:Class="FM24FaceAssistant.SpecialPortraitPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FM24FaceAssistant" Margin="14">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="特殊角色头像" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="管理常规名单中找不到的自己、新闻官、个人助理等人物。" TextWrapping="Wrap" Foreground="#BDB7D2" Margin="3,4,3,8"/>

   <WrapPanel><Button Content="新建角色" Click="NewEntry"/><Button x:Name="EditButton" Content="编辑" Click="EditEntry"/><Button x:Name="DeleteButton" Content="删除" Click="DeleteEntry" ToolTip="删除角色并恢复该角色通过助手应用的头像。"/></WrapPanel>
  </StackPanel>
  <Button DockPanel.Dock="Bottom" Content="如何获取 UID" Click="OpenUidGuide" HorizontalAlignment="Left" Margin="3,10,3,3"/>
   <ListBox x:Name="Saved" SelectionChanged="SelectSaved" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="选择角色后，在右侧更换头像。" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Person.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,3" ToolTip="{Binding Person.Name}"/><ItemsControl Style="{StaticResource MetadataTags}" ItemsSource="{Binding Tags}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel>
  <DockPanel Grid.Column="2">
   <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="RoleTitle" Text="选择角色" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><ItemsControl x:Name="RoleTags" Style="{StaticResource MetadataTags}"/><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="当前头像"/><Grid Height="125"><Border Background="#302C46" CornerRadius="6" Margin="8,0" Visibility="{Binding Source,ElementName=Current,Converter={StaticResource MissingPortrait}}"><Path Width="40" Height="45" Stretch="Uniform" Stroke="#9B92B2" StrokeThickness="1.4" Data="M18,1 A8,8 0 1 1 17.99,1 M2,38 C2,18 34,18 34,38 Z"/></Border><Image x:Name="Current" Stretch="Uniform"/></Grid></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="待应用"/><Grid Height="125"><Border Background="#302C46" CornerRadius="6" Margin="8,0" Visibility="{Binding Source,ElementName=Preview,Converter={StaticResource MissingPortrait}}"><Path Width="40" Height="45" Stretch="Uniform" Stroke="#9B92B2" StrokeThickness="1.4" Data="M18,1 A8,8 0 1 1 17.99,1 M2,38 C2,18 34,18 34,38 Z"/></Border><Image x:Name="Preview" Stretch="Uniform"/></Grid></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="ImportButton" Content="导入图片" Click="Import" HorizontalAlignment="Left"/><Button x:Name="RandomButton" Content="随机选一张" Click="Randomize" HorizontalAlignment="Left"/><Button x:Name="ManagerSetupButton" Content="主教练头像设置" Click="OpenManagerSetup" Visibility="Collapsed" HorizontalAlignment="Left" ToolTip="自己主教练的头像没有变化时，导出已应用的图片并查看游戏内设置方法。"/><ItemsControl x:Name="ChoiceInfo" Style="{StaticResource MetadataTags}" MaxWidth="260" HorizontalAlignment="Left"/></StackPanel>
   </Grid><WrapPanel><Button x:Name="RecommendButton" Content="加载推荐头像" Click="Recommend"/><CheckBox x:Name="All" Content="不限国籍浏览" ToolTip="浏览全部职员头像，可手动纠正推荐。" VerticalAlignment="Center" Click="Recommend"/><Button Content="上一页" Click="Previous"/><TextBlock x:Name="Region" VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Page" Text="0 / 0" VerticalAlignment="Center"/><Button Content="下一页" Click="Next"/></WrapPanel></StackPanel>
   <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button x:Name="RestoreButton" Content="恢复原图" Click="Restore"/><Button x:Name="ApplyButton" Content="应用头像" Click="Apply"/><Button x:Name="RefreshButton" Content="应用并刷新游戏" Click="ApplyRefresh" Background="#A87829" BorderBrush="#706582"/></WrapPanel>
   <ListBox x:Name="Images" SelectionChanged="PickFace" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="2"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="7"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Group}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding Path,Converter={StaticResource Thumbnail}}" Stretch="Uniform"/><TextBlock Grid.Row="1" Text="{Binding Group}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel>
 </Grid>
</UserControl>
