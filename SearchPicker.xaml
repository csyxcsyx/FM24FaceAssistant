<UserControl x:Class="FM24FaceAssistant.SearchPicker" x:Name="RootPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="3" Height="32" MinHeight="32" PreviewKeyDown="PickerKeyDown">
 <Grid ClipToBounds="True">
  <Border x:Name="Frame" Background="#242137" BorderBrush="#706582" BorderThickness="1" CornerRadius="4" Padding="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Margin="0" Padding="7,0" Height="28" MinHeight="28" FontSize="13" VerticalContentAlignment="Center" TextChanged="EditChanged" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" IsHitTestVisible="False" Margin="7,0,0,0" Foreground="#BDB7D2" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Editor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Button x:Name="Arrow" Grid.Column="1" Focusable="False" Click="TogglePopup" Margin="0" Padding="7" MinHeight="28" ToolTip="展开选项" AutomationProperties.Name="展开选项">
     <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ArrowSurface" Background="Transparent" CornerRadius="0,4,4,0"><Path Data="M0,0 L4,4 L8,0" Stroke="#C8C0DA" StrokeThickness="1.5" Width="9" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="#655371"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
    </Button>
   </Grid>
  </Border>
  <Popup x:Name="Dropdown" Placement="Bottom" PlacementTarget="{Binding ElementName=Frame}" StaysOpen="False" AllowsTransparency="True" Closed="PopupClosed">
   <Border Background="#343149" BorderBrush="#8B7B9E" BorderThickness="1" CornerRadius="4" Width="{Binding PopupWidth, ElementName=RootPicker}" Padding="3">
    <Grid><ListBox x:Name="OptionsList" Background="#343149" FontSize="13" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" MouseLeftButtonUp="PickItem" PreviewKeyDown="ListKeyDown" AutomationProperties.Name="搜索结果">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="7,6"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock x:Name="Empty" Text="没有匹配项" Foreground="#BDB7D2" Margin="10" Visibility="Collapsed"/></Grid>
   </Border>
  </Popup>
 </Grid>
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A69AB8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers></Style></UserControl.Style>
</UserControl>
