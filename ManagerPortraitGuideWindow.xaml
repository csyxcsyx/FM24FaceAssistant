<Window x:Class="FM24FaceAssistant.ManagerPortraitGuideWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#242137" Foreground="#F4F0F9" FontFamily="Microsoft YaHei UI" FontSize="14" Title="主教练头像设置" Icon="assistant.ico" Width="650" Height="440" MinWidth="580" MinHeight="410" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="GuideKeyDown">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="主教练头像设置" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="FM 为玩家主教练提供了单独的头像入口；映射已写入但未显示时，使用下面的方式。" Foreground="#BDB7D2" TextWrapping="Wrap" Margin="3,8,3,18"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock x:Name="Steps" TextWrapping="Wrap" LineHeight="26"/>
   <Border x:Name="FileBox" Background="#343046" CornerRadius="6" Padding="12" Margin="3,16,3,8"><StackPanel><TextBlock x:Name="FileName" FontWeight="SemiBold"/><TextBlock x:Name="Folder" Foreground="#BDB7D2" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
   <TextBlock x:Name="Feedback" Foreground="#C5BAD7" TextWrapping="Wrap" Margin="3,6"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button x:Name="CopyButton" Content="复制图片路径" Click="CopyPath"/><Button x:Name="FolderButton" Content="打开图片位置" Click="OpenFolder"/><Button Content="关闭" Click="CloseGuide"/></WrapPanel>
 </Grid>
</Window>
