<Window x:Class="FM24FaceAssistant.SkinInstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FM24FaceAssistant" Title="安装配套皮肤" Icon="assistant.ico" Width="760" Height="590" MinWidth="680" MinHeight="560" Background="#242137" Foreground="#F4F0F9" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="InstallerClosing" PreviewKeyDown="InstallerKeyDown">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><DockPanel><local:AppIcon Kind="Skin" Width="28" Height="28" Foreground="#D8C08B" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="安装配套皮肤" FontSize="24" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="Intro" Text="未找到 FLAYUS skin 24 YUXIANde。可安装随附版本，或选择已有皮肤。" Foreground="#BDB7D2" TextWrapping="Wrap" Margin="3,10,3,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#343149" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="使用配套皮肤" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="在收件箱显示特殊角色 UID。&#10;从游戏工具栏直接打开头像助手。" TextWrapping="Wrap" Foreground="#D2CCDF" LineHeight="23" Margin="0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="#302C43" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="继续使用其他皮肤" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="搜索、换图和批量补全仍可使用。&#10;没有上述 UID 显示和工具栏入口。" TextWrapping="Wrap" Foreground="#D2CCDF" LineHeight="23" Margin="0"/></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="2"><TextBlock Text="安装位置（皮肤文件夹）" FontWeight="SemiBold"/><DockPanel Margin="0,4"><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="更改位置" Click="BrowseDestination"/><TextBox x:Name="Destination" ToolTip="可直接修改完整路径。安装到空文件夹，不覆盖已有文件。" AutomationProperties.Name="皮肤安装位置"/></DockPanel><WrapPanel><Button x:Name="ExistingButton" Content="选择已有皮肤" Click="ChooseExisting" ToolTip="皮肤放在默认目录之外时，直接选择包含 skin_config.xml 的现有皮肤文件夹。"/><TextBlock Text="已有安装？选择它即可，无需重复解压。" Foreground="#BDB7D2" VerticalAlignment="Center"/></WrapPanel></StackPanel>
  <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="3,12,3,0"><TextBlock x:Name="State" Text="安装后，在 FM 偏好选择中选择该皮肤，再重载皮肤。" TextWrapping="Wrap" LineHeight="22"/><StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,10,0,0"><ProgressBar x:Name="InstallProgress" Height="10" Maximum="100" Foreground="#E6AD42" Background="#181628" BorderThickness="0"/><TextBlock x:Name="ProgressText" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="CurrentFile" Foreground="#BDB7D2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/></StackPanel></StackPanel>
  <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="NoPrompt" Content="未安装时不再提示" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LaterButton" Content="暂不安装" Click="CloseInstaller" MinWidth="94"/><Button x:Name="InstallButton" Content="安装皮肤" Click="InstallSkin" MinWidth="110" Background="#A87829"/></StackPanel></Grid>
 </Grid>
</Window>
