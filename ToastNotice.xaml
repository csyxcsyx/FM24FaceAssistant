<UserControl x:Class="FM24FaceAssistant.ToastNotice" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FM24FaceAssistant" Visibility="Collapsed" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="40">
 <Border Background="#46405C" BorderBrush="#A99260" BorderThickness="1" CornerRadius="9" Padding="38,26" MinHeight="180">
  <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.32"/></Border.Effect>
  <StackPanel VerticalAlignment="Center">
   <local:AppIcon x:Name="Icon" Kind="Information" Width="34" Height="34" Foreground="#FFE1A3" HorizontalAlignment="Center" Margin="0,0,0,12"/>
   <TextBlock x:Name="Message" FontSize="20" LineHeight="30" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFFFFF" Margin="0" MaxHeight="240" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
   <Button x:Name="LogButton" Content="查看错误日志" Click="OpenLog" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0"/>
  </StackPanel>
 </Border>
</UserControl>
