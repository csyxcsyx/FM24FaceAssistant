<Window x:Class="FM24FaceAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FM24FaceAssistant" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Background="#242137" Foreground="#F4F0F9" FontFamily="Microsoft YaHei UI" FontSize="14" Icon="assistant.ico" PreviewKeyDown="WindowKeyDown" PreviewGotKeyboardFocus="HelpFocus" Title="FM24 头像助手" Width="1280" Height="840" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen">
 <Grid Background="#242137"><DockPanel x:Name="MainSurface" Margin="16" Background="#242137">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="头像助手" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="尚未更新名单 · 通用模式" Foreground="#BDB7D2"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Click="ReadGame"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" VerticalAlignment="Center"/><TextBlock Text="更新名单"/></StackPanel></Button><Button Content="取消任务" Click="CancelTask" x:Name="CancelButton" IsEnabled="False"/><Button Content="隐藏到托盘" Click="HideTray"/></StackPanel></Grid>
  <TabControl x:Name="Tabs" Background="#29263F" BorderBrush="#49455E">
   <TabItem Header="头像管理"><Grid Margin="12" TextElement.Foreground="#F4F0F9"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="姓名 / ID"/><TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="搜索姓名或 ID" AutomationProperties.Name="搜索姓名或 ID"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="人物类型"/><ComboBox x:Name="KindFilter" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部人物" IsSelected="True"/><ComboBoxItem Content="球员"/><ComboBoxItem Content="职员"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="国籍"/><local:SearchPicker x:Name="NationFilter" Placeholder="All nations" PopupWidth="280" QueryChanged="FilterChanged" ToolTip="输入中英文国籍搜索，或展开列表选择；清空显示全部。" AutomationProperties.Name="国籍搜索选择"/></StackPanel></Grid><TextBox Visibility="Collapsed" x:Name="ClubFilter" TextChanged="FilterChanged" ToolTip="按俱乐部筛选" AutomationProperties.Name="俱乐部筛选"/><TextBlock x:Name="PersonCount"/></StackPanel><ListBox x:Name="PeopleList" SelectionChanged="PersonSelected" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Width="240" Margin="4,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><ItemsControl Style="{StaticResource MetadataTags}" ItemsSource="{Binding ListTags}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
    <DockPanel Grid.Column="2"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="PersonTitle" Text="选择人物" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><ItemsControl x:Name="PersonInfo" Style="{StaticResource MetadataTags}" MinHeight="30"/><Button x:Name="GenderHelp" Style="{StaticResource HelpButton}" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="职员性别匹配说明"/></StackPanel><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前头像"/><Grid Height="100"><Border Margin="12,0" Background="#302C46" BorderBrush="#59516E" BorderThickness="1" CornerRadius="6" Visibility="{Binding Source, ElementName=CurrentImage, Converter={StaticResource MissingPortrait}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Path Width="36" Height="40" Stretch="Uniform" Stroke="#9B92B2" StrokeThickness="1.4" Data="M18,1 A8,8 0 1 1 17.99,1 M2,38 C2,18 34,18 34,38 Z"/><TextBlock Text="暂无头像" FontSize="11" Foreground="#BDB7D2" TextAlignment="Center"/></StackPanel></Border><Image x:Name="CurrentImage" Height="100" Stretch="Uniform"/></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="待应用"/><Grid Height="100"><Border Margin="12,0" Background="#302C46" BorderBrush="#59516E" BorderThickness="1" CornerRadius="6" Visibility="{Binding Source, ElementName=PendingImage, Converter={StaticResource MissingPortrait}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Path Width="36" Height="40" Stretch="Uniform" Stroke="#9B92B2" StrokeThickness="1.4" Data="M18,1 A8,8 0 1 1 17.99,1 M2,38 C2,18 34,18 34,38 Z"/><TextBlock Text="待选头像" FontSize="11" Foreground="#BDB7D2" TextAlignment="Center"/></StackPanel></Border><Image x:Name="PendingImage" Height="100" Stretch="Uniform"/></Grid></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><ItemsControl x:Name="MatchInfo" Style="{StaticResource MetadataTags}"/><WrapPanel><CheckBox x:Name="LockFace" Content="锁定头像" IsChecked="True" Margin="5"/><Button Style="{StaticResource HelpButton}" ToolTip="锁定后，自动补全不会重新分配此人的头像。手动更换仍可使用。" AutomationProperties.Name="锁定头像说明"/></WrapPanel><WrapPanel><Button Content="导入图片" Click="ImportImage"/><Button Content="随机重选" Click="Reroll"/></WrapPanel></StackPanel></Grid><WrapPanel><CheckBox x:Name="AllFaces" Content="全部素材" Click="ScopeChanged" VerticalAlignment="Center" ToolTip="默认只展示对应国籍的推荐头像。勾选后可手动选择其他地区素材；职员可同时浏览男女头像。"/><TextBlock Text="分类" VerticalAlignment="Center"/><local:SearchPicker x:Name="GroupFilter" Placeholder="All categories" PopupWidth="280" Width="170" QueryChanged="GalleryChanged" ToolTip="输入中英文分类搜索，或展开列表选择。要浏览推荐范围外的分类，请勾选全部素材。" AutomationProperties.Name="素材分类搜索选择"/><Button Content="上一页" Click="PreviousPage"/><TextBlock x:Name="GalleryRegion" MaxWidth="160" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center"/><Button Content="下一页" Click="NextPage"/></WrapPanel></StackPanel>
     <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button Content="恢复原图" Click="RestorePerson"/><Button Content="应用头像" Click="ApplyFace"/><Button Background="#A87829" BorderBrush="#706582" Content="应用并刷新游戏" Click="ApplyRefresh"/><Button Style="{StaticResource HelpButton}" ToolTip="先保存头像，再切回 FM 发送重载皮肤快捷键。若游戏没有变化，请检查快捷键和游戏图片缓存设置。" AutomationProperties.Name="应用并刷新游戏说明"/></WrapPanel>
     <ListBox x:Name="Gallery" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="FaceSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="7"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid Margin="3" ToolTip="{Binding Group}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding Path, Converter={StaticResource Thumbnail}}" Stretch="Uniform"/><TextBlock Grid.Row="1" Text="{Binding Group}" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
   </Grid></TabItem>
   <TabItem Header="自动补全"><local:BatchPanel x:Name="BatchView" PreviewRequested="PreviewMatch" ApplyRequested="ApplyBatch" ApplyRefreshRequested="ApplyBatchRefresh" RefreshRequested="RefreshBatch" AutoChanged="AutoScanChanged"/></TabItem>
   <TabItem Header="特殊角色"><local:SpecialPortraitPanel x:Name="SpecialView" ApplyRequested="ApplySpecialPortrait"/></TabItem>
   <TabItem Header="设置与恢复">
    <TabControl Margin="12">
     <TabItem Header="常用"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="路径与图库" FontSize="20" FontWeight="SemiBold" Margin="3,0,3,14"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="FM24 用户资料目录" VerticalAlignment="Center"/><Button Style="{StaticResource HelpButton}" ToolTip="包含 graphics、skins、games 等文件夹的 FM24 用户目录，不是 Steam 安装目录。选择后点击保存设置。" AutomationProperties.Name="用户目录说明"/></StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseDocuments" ToolTip="定位 FM24 的用户资料文件夹；不会移动或删除其中的文件。"/><TextBox x:Name="DocsPath" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="NG_Regens 图库目录" VerticalAlignment="Center"/><Button Style="{StaticResource HelpButton}" ToolTip="选择已经解压的素材目录。只有更换或添加图库时才需要重新索引；日常打开会复用缓存。" AutomationProperties.Name="图库目录说明"/></StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择并索引" Click="ChoosePack" ToolTip="选择新素材目录，并校验图片、更新图库缓存。耗时取决于图片数量，可取消。"/><TextBox x:Name="PackPath" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="图库下载与断点目录" VerticalAlignment="Center"/><Button Style="{StaticResource HelpButton}" ToolTip="首次下载默认保存在用户数据目录；也可选择空间充足的其他磁盘。此处仅影响图库包、解压素材和下载断点。更换位置不会移动原目录文件。" AutomationProperties.Name="图库下载目录说明"/></StackPanel>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="自动" Click="ResetLibraryDownload" ToolTip="恢复自动选择下载位置，原目录文件仍保留。"/><Button Content="选择目录" Click="ChooseLibraryDownload"/></StackPanel><TextBox x:Name="LibraryDownloadPath" ToolTip="留空时自动选择合适的数据目录。可选择其他磁盘，原下载文件不会自动移动。"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="保存设置" Click="SaveSettings" Background="#A87829" BorderBrush="#706582" ToolTip="保存目录和游戏集成页的快捷键设置，不会重新分配头像。"/><TextBlock Text="更换目录后保存；平时无需重新索引。" Foreground="#BDB7D2" VerticalAlignment="Center"/></StackPanel>
       </StackPanel>
       <Border Grid.Column="2" Padding="16" Background="#343149" CornerRadius="5"><StackPanel><TextBlock Text="当前资源" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ResourceSummary" Text="正在读取缓存…" Margin="3,10"/><TextBlock x:Name="LibraryDownloadStatus" Text="图库下载状态：点击查看" Margin="3,6"/><UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="下载 / 接续图库" Click="DownloadLibrary" ToolTip="本地无图库时下载官方素材包并建立索引；已有图库时直接复用。无需安装额外环境，支持取消后接续。"/><Button Content="查看下载进度" Click="ViewLibraryMonitor"/><Button Content="打开数据目录" Click="OpenState" ToolTip="打开分配记录、日志和恢复备份所在的本地文件夹。"/></UniformGrid></StackPanel></Border>
      </Grid>
     </Grid></TabItem>
     <TabItem Header="存档记录"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="存档头像记录" FontSize="20" FontWeight="SemiBold"/><Button Style="{StaticResource HelpButton}" ToolTip="每份生涯使用一套头像记录，避免相同新人 ID 在不同生涯中互相覆盖。切换后加载对应游戏存档，再扫描并应用；只玩一份生涯时无需切换。" AutomationProperties.Name="存档记录说明"/></StackPanel>
      <TextBlock Grid.Row="1" x:Name="ProfileState" Foreground="#FFE1A3" Margin="3,8"/>
      <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="310"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
       <TextBlock Text="已有记录" VerticalAlignment="Center"/><ComboBox x:Name="ProfileChoice" Grid.Column="1"/><Button Grid.Column="2" Content="使用所选记录" Click="SwitchProfile"/><Button Grid.Column="3" Content="删除所选记录" Click="DeleteProfile"/>
       <TextBlock Grid.Row="1" Text="新记录名称" VerticalAlignment="Center"/><TextBox x:Name="ProfileName" Grid.Row="1" Grid.Column="1" ToolTip="例如 King's Lynn 2024。只有玩另一份生涯存档时才需要新建。"/><Button Grid.Row="1" Grid.Column="2" Content="创建并使用" Click="CreateProfile"/>
      </Grid>
      <UniformGrid Grid.Row="3" Columns="2" Rows="2" Height="144" VerticalAlignment="Top"><Button Height="66" Style="{StaticResource SettingsAction}" Content="导入人物 JSON" Tag="从文件恢复名单，再扫描头像。" Click="ImportPeople"/><Button Height="66" Style="{StaticResource SettingsAction}" Content="导出人物 JSON" Tag="备份当前名单，便于查看人物资料。" Click="ExportPeople"/><Button Height="66" Style="{StaticResource SettingsAction}" Content="重建外部头像索引" Tag="头像包大幅变化或映射异常时使用。" Click="RebuildIndex"/><Button Height="66" Style="{StaticResource SettingsAction}" Content="下载 / 接续图库" Tag="下载官方 NG_Regens 素材，已有图库直接复用。" Click="DownloadLibrary"/></UniformGrid>
      <TextBlock Grid.Row="4" Text="记录只管理头像和名单，不会加载、保存或删除 FM 游戏存档。" Foreground="#BDB7D2" FontSize="13" TextWrapping="Wrap" Margin="3,10,3,2"/>
     </Grid></TabItem>
     <TabItem Header="游戏集成"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="快捷键与皮肤入口" FontSize="20" FontWeight="SemiBold" Margin="3,0,3,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="通用模式" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,8"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="唤出程序快捷键" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="HotkeyBox"/><Button Grid.Column="2" Style="{StaticResource HelpButton}" HorizontalAlignment="Left" ToolTip="程序驻留时按此组合键显示窗口；默认 Ctrl+Alt+F。若被其他软件占用，请修改后保存。" AutomationProperties.Name="唤出快捷键说明"/><TextBlock Grid.Row="1" Text="重载皮肤快捷键" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="RefreshBox"/><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource HelpButton}" HorizontalAlignment="Left" ToolTip="应用并刷新时发送到 FM 的按键，默认 Shift+R。是否有效取决于游戏设置；测试会切回游戏。" AutomationProperties.Name="刷新快捷键说明"/></Grid>
       <Button Content="保存设置" Click="SaveSettings" HorizontalAlignment="Left" Background="#A87829" BorderBrush="#706582" ToolTip="保存快捷键与目录。"/><UniformGrid Columns="2" Margin="0,8"><Button Style="{StaticResource SettingsAction}" Content="测试刷新键" Tag="切回 FM 发送一次刷新键，不重新换图。" Click="RefreshGame" ToolTip="测试游戏能否接收设置的刷新快捷键；不会推进日期或保存游戏。"/><Button Style="{StaticResource SettingsAction}" Content="检查刷新设置" Tag="检查本地缓存与重载皮肤的偏好设置。" Click="DiagnoseRefresh" ToolTip="读取本地偏好文件并显示建议，不会擅自修改游戏设置。"/></UniformGrid>

      </StackPanel>
      <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="配套皮肤与游戏入口" FontSize="16" FontWeight="SemiBold"/><Button Style="{StaticResource HelpButton}" ToolTip="配套皮肤提供收件箱特殊角色 UID 显示和游戏内唤出按钮。其他皮肤仍可从程序窗口、托盘或快捷键换图。" AutomationProperties.Name="皮肤入口说明"/></StackPanel><TextBlock Text="皮肤位置" Margin="3,10,3,2"/><DockPanel><Button DockPanel.Dock="Right" Content="选择已有" Click="ChooseSkin" ToolTip="选择包含 skin_config.xml 的 FLAYUS skin 24 YUXIANde 目录。"/><TextBox x:Name="SkinPath" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
       <Button Content="安装随附皮肤…" Click="OpenSkinInstaller" HorizontalAlignment="Left" Margin="3,8,3,5" ToolTip="使用程序自带的压缩包安装皮肤，可修改安装位置；不会覆盖已有文件。"/>
       <CheckBox x:Name="SkinPromptCheck" Content="启动时提醒安装缺失的配套皮肤" IsChecked="True" Click="SkinPromptChanged" ToolTip="关闭后仍可随时从这里安装皮肤或选择已有目录。"/>
       <StackPanel Orientation="Horizontal" Margin="0,6"><CheckBox x:Name="ShowSkinEntry" Content="在游戏中显示头像助手入口" IsChecked="True" Click="SkinEntryChanged"/><Button Style="{StaticResource HelpButton}" ToolTip="自动配置唤出协议和白色工具栏图标。勾选或取消后，重载一次游戏皮肤生效；不会影响头像分配。" AutomationProperties.Name="游戏入口说明"/></StackPanel>
       <TextBlock x:Name="SkinEntryState" Text="启动后自动配置；重载皮肤后生效。" Foreground="#BDB7D2" TextWrapping="Wrap" Margin="3,8"/>

      </StackPanel>
     </Grid></Grid></TabItem>
     <TabItem Header="恢复"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="恢复原头像包" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Text="移除当前记录中助手分配的头像，恢复到仅使用原头像包的状态。" Foreground="#BDB7D2" Margin="3,10" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="2" Margin="0,4,0,16"><TextBlock Text="包括手动换图、批量补全和特殊角色；保留人物名单及图库。" TextWrapping="Wrap" Margin="3,0,3,10"/><StackPanel Orientation="Horizontal"><Button Content="恢复原头像包" Background="#A87829" BorderBrush="#706582" Click="RestoreOriginal"/><CheckBox x:Name="RefreshAfterRestore" Content="恢复后刷新游戏皮肤" IsChecked="True" VerticalAlignment="Center"/></StackPanel></StackPanel>
      <UniformGrid Grid.Row="3" Columns="2" HorizontalAlignment="Stretch"><Button Style="{StaticResource SettingsAction}" Content="打开数据与备份目录" Tag="查看本地日志和自动恢复备份。" Click="OpenState"/><Button Style="{StaticResource SettingsAction}" Content="退出工具" Tag="结束驻留，已应用的头像继续保留。" Click="ExitApp"/></UniformGrid>
     </Grid></TabItem>
    </TabControl>
   </TabItem>
  </TabControl>
 </DockPanel>
 <Grid KeyboardNavigation.TabNavigation="Cycle" x:Name="BusyLayer" Visibility="Collapsed" Background="#B0181728"><Border Width="420" Padding="28" Background="#343149" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><DockPanel><Ellipse x:Name="Spinner" DockPanel.Dock="Left" Width="24" Height="24" Margin="3,0,12,0" Stroke="#E6AD42" StrokeThickness="3" StrokeDashArray="4,2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse><TextBlock Text="正在处理" FontSize="22" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="TaskBar" IsIndeterminate="True" Height="12" Background="#242137" BorderThickness="0" Margin="3,18" Foreground="#E6AD42"/><TextBlock x:Name="TaskCount"/><TextBlock x:Name="TaskDetail" TextWrapping="Wrap" MinHeight="64"/><Button x:Name="TaskCancel" Content="取消任务" Click="CancelTask" HorizontalAlignment="Right"/></StackPanel></Border></Grid>
 <local:ToastNotice x:Name="Notice"/></Grid></Window>
